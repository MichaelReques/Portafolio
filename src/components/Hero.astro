---
import "../styles/global.css";
import IconWhatsapp from "../components/IconWhatsapp.astro";
import IconLinkedin from "../components/IconLinkedin.astro";
import IconGithub from "../components/IconGithub.astro";

const contactItems = [
  {
    label: "Contáctame",
    href: "https://wa.me/51907426756",
    icon: IconWhatsapp,
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/michael-reques-fernandez-0a9b84288/?isSelfProfile=true",
    icon: IconLinkedin,
  },
  {
    label: "GitHub",
    href: "https://github.com/MichaelReques",
    icon: IconGithub,
  },
];
---

<section class="mt-25">
  <div class="flex items-center mb-4">
    <img
      src="./assets/michael.jpeg"
      alt="Michael Reques"
      class="rounded-full w-20 h-20 object-cover mr-4 border-yellow-400 border-2 shadow-[0_0_50px_rgba(255,255,246,0.5)]"
    />
    <p
      class="text-white font-normal text-sm border-2 border-amber-300/35 px-3 py-1 rounded-3xl"
    >
      Disponible para trabajar
    </p>
  </div>
  <div class="max-w-xl">
    <h1 class="text-5xl font-bold text-white">
      Hey, soy <span class="text-amber-500">Michael</span>
    </h1>
    <p class="mt-4 text-zinc-400 font-semibold text-lg">
      Estudiante de Ingeniería de Software. <span class="text-yellow-200"
        >Desarrollador FullStack</span
      > de Lima, Perú. Especializado en <span class="text-yellow-200"
        >construir aplicaciones web completas</span
      >, de inicio a fin.
    </p>
  </div>
  <div class="mt-8 flex flex-wrap gap-3">
    {
      contactItems.map(({ label, href, icon: Icon }) => (
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 text-sm sm:text-base text-white bg-blue-950/30 border-[0.5px] border-white rounded-2xl px-4 py-2 sm:px-5 sm:py-1.5
        hover:bg-white hover:text-blue-950 hover:border-blue-950 hover:shadow-[0_0_50px_rgba(255,255,246,0.5)] transition-all duration-300"
        >
          <Icon />
          {label}
        </a>
      ))
    }
  </div>
</section>
