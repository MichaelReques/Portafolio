---
import "../styles/global.css";
import { Icon } from "astro-icon/components";

const projects = [
  {
    title: "STR80 - Compañía de Bomberos",
    description:
      "Pagina web creada para la compañia de bomberos de Chancay con Next.js y Tailwind CSS.",
    image: "./assets/p1.png",
    tech: [
      { name: "Next.js", icon: "tabler:brand-nextjs" },
      { name: "Tailwind CSS", icon: "tabler:brand-tailwind" },
    ],
    preview: "https://santiagotavararenovaleschancay80.vercel.app/",
  },
  {
    title: "Tomatina Trattoria",
    description: "Landing Page creada para un restaurante de comida italiana con React y Tailwind CSS.",
    image: "./assets/p2.png",
    tech: [
      { name: "React", icon: "tabler:brand-react" },
      { name: "Tailwind CSS", icon: "tabler:brand-tailwind" },
    ],
    // sin "code": solo se muestra el botón Preview
    preview: "https://tu-proyecto.com",
  },
];
---

<section id="proyectos" class="mt-20">
  <div class="flex items-center gap-3 mb-10">
    <Icon name="tabler:code" class="text-white w-7 h-7" />
    <h2 class="text-3xl font-bold text-white">Proyectos</h2>
  </div>

  <div class="flex flex-col gap-12">
    {
      projects.map(({ title, description, image, tech, preview }) => (
        <article class="grid gap-6 md:grid-cols-[1fr_1fr] md:items-center">
          <img
            src={image}
            alt={title}
            class="w-full rounded-2xl border border-white/10 object-cover aspect-video"
          />

          <div>
            <h3 class="text-2xl font-bold text-white">{title}</h3>

            <ul class="mt-3 flex flex-wrap gap-2">
              {tech.map(({ name, icon }) => (
                <li class="flex items-center gap-1.5 rounded-full bg-blue-950/50 px-3 py-1 text-xs font-semibold text-white">
                  <Icon name={icon} class="w-4 h-4" />
                  {name}
                </li>
              ))}
            </ul>

            <p class="mt-4 text-zinc-400">{description}</p>

            <div class="mt-5 flex gap-3">
              
              {preview && (
                <a
                  href={preview}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2 rounded-xl border border-white/10 px-4 py-2 font-semibold text-white hover:bg-white/10 transition-colors"
                >
                  <Icon name="tabler:external-link" class="w-5 h-5" />
                  Preview
                </a>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
